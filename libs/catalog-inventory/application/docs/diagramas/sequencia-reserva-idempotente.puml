@startuml sequencia-reserva-idempotente
!include ../../../../../docs/diagramas/tema-catalogo.iuml
title Reserva idempotente em ReservationService.reserve
autonumber

participant "$I_SISTEMA\nCheckout / OMS\n(via API)" as client <<ator>>
box "Aplicação" #F5FAFF
  participant "$I_ESTOQUE\nReservationService" as svc <<aplicacao>>
end box
box "Domínio" #F6FBF6
  participant "$I_DOMINIO\nReservationPolicy\n(domínio)" as policy <<dominio>>
end box
box "Saída (portas)" #FBF6FC
  participant "$I_REPOSITORIO\nInventoryRepository\n<size:10><i>«interface»</i></size>" as inv <<saida>>
  participant "$I_REPOSITORIO\nReservationRepository\n<size:10><i>«interface»</i></size>" as repo <<saida>>
end box

client -> svc : reserve(actor, request)
svc -> svc : require(MANAGE_RESERVATIONS)\nvalida chave [\\x21-\\x7E]{1,255}\nhash = SHA-256 canônico

== Chave nova ==
svc -> repo : findByIdempotencyKey(tenant, chave)
repo --> svc : vazio
svc -> inv : candidates(tenant, skuIds)
inv --> svc : SkuCandidate por SKU
svc -> policy : open(..., hash, ttl ou defaultTtl, maxTtl)
policy --> svc : Reservation ACTIVE\n(ou ReservationRefusal)
svc -> repo : insert(reserva)
repo --> svc : ok (ou insufficient-stock)
svc --> client : Result(reserva, replayed = false)

== Replay idêntico ==
svc -> repo : findByIdempotencyKey(tenant, chave)
repo --> svc : reserva existente
svc -> svc : replay: requestHash == hash
svc --> client : Result(reserva no estado atual, replayed = true)
note right : sem nova checagem de saldo,\npreço ou status da reserva

== Chave reutilizada com corpo diferente ==
svc -> repo : findByIdempotencyKey(tenant, chave)
repo --> svc : reserva existente
svc -> svc : replay: requestHash != hash
svc -[#C62828]-> client : <color:#C62828>DomainRuleViolation\n<color:#C62828>idempotency-key-reused (422)

== Corrida: duas chamadas com a mesma chave nova ==
svc -> repo : findByIdempotencyKey(tenant, chave)
repo --> svc : vazio (a outra ainda não gravou)
svc -> inv : candidates(tenant, skuIds)
svc -> policy : open(...)
svc -> repo : insert(reserva)
repo -[#C62828]-> svc : <color:#C62828>DuplicateException\n<color:#C62828>(a outra gravou primeiro)
svc -> repo : findByIdempotencyKey(tenant, chave)
alt #E8F5E9 reserva encontrada e mesmo hash
  repo --> svc : reserva da outra chamada
  svc --> client : Result(reserva, replayed = true)
else #FFEBEE reserva encontrada e hash diferente
  svc -[#C62828]-> client : <color:#C62828>idempotency-key-reused (422)
else #FFEBEE reserva não encontrada
  svc -[#C62828]-> client : <color:#C62828>ConcurrentUpdateException (409)
end

legend right
  <b>Leitura</b>
  <back:#F9A825>    </back> Cliente externo
  <back:#1565C0>    </back> Aplicação (caso de uso)
  <back:#2E7D32>    </back> Domínio
  <back:#6A1B9A>    </back> Saída (portas)
  <back:#66BB6A>    </back> Caminho feliz
  <back:#E57373>    </back> Falha ou recusa (status HTTP / problem)
endlegend
@enduml
