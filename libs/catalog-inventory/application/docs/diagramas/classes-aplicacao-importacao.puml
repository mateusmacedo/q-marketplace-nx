@startuml classes-aplicacao-importacao
!include ../../../../../docs/diagramas/tema-catalogo.iuml
set separator none
title Aplicação: tipos da importação de produtos em lote (linhas, resultados, lote, unidades de processamento e partes do caso de uso)

hide empty members
hide <<aplicacao>> stereotype
skinparam nodesep 20
skinparam ranksep 40
skinparam ClassBackgroundColor<<record>> #F1F8FF
skinparam ClassBorderColor<<record>> #64B5F6
skinparam ClassBackgroundColor<<record, privada>> #F1F8FF
skinparam ClassBorderColor<<record, privada>> #64B5F6
skinparam ClassBackgroundColor<<sealed, privada>> #F1F8FF
skinparam ClassBorderColor<<sealed, privada>> #64B5F6

package "$I_CSV Importação de produtos" as importacao <<aplicacao>> {
  class ImportRow <<record>> {
    lineNumber : int
    productRef : String
    categoryCode : String
    title : String
    description : String
    attributes : Map<String, String>
    sellerSku : String
    variantAttributes : Map<String, String>
    physical : Boolean
    heightCm, widthCm, lengthCm : BigDecimal
    weightGrams : Integer
    currency : String
    listPrice, salePrice : BigDecimal
    onHand : Integer
    error : String
    productError : String
    --
    {static} invalid(lineNumber, productRef, sellerSku, error) : ImportRow
  }
  class ImportResult <<record>> {
    {static} SELLER_SKU_MAX_LENGTH = 100
    {static} MESSAGE_MAX_LENGTH = 1000
    lineNumber : int
    sellerSku : String
    outcome : ImportOutcome
    code : String
    message : String
    productId : UUID
    reasons : List<Reason>
    --
    ~{static} succeeded(row, outcome, productId) : ImportResult
    ~{static} failed(row, productId, code, message) : ImportResult
    ~{static} failed(row, productId, code, message, reasons) : ImportResult
  }
  enum "ImportResult.ImportOutcome" as ImportOutcome {
    CREATED
    UPDATED
    UNCHANGED
    FAILED
  }
  class ProductImport <<record>> {
    id : UUID
    tenantId : UUID
    storeId : UUID
    actor : String
    status : ImportStatus
    totalLines : int
    createdAt : Instant
    startedAt : Instant
    finishedAt : Instant
    --
    {static} pending(id, tenantId, storeId, actor, totalLines, now) : ProductImport
    seller() : Actor
  }
  enum "ProductImport.ImportStatus" as ImportStatus {
    PENDING
    PROCESSING
    COMPLETED
  }
  class "ProductImportRepository.Claimed" as Claimed <<record>> {
    job : ProductImport
    content : String
  }
  class "ProductImportRepository.Summary" as Summary <<record>> {
    job : ProductImport
    created : int
    updated : int
    unchanged : int
    failed : int
    --
    processedLines() : int
  }
  class "ProductImportRepository.Position" as Position <<record>> {
    createdAt : Instant
    id : UUID
  }
  class "ProductImportService.Report" as Report <<record>> {
    job : ProductImport
    lines : List<ImportResult>
  }
  class ProductImportService <<final>> <<serviço>> {
    {static} INVALID_ROW = "invalid-row"
    {static} DUPLICATE_SELLER_SKU = "duplicate-seller-sku"
    {static} INCONSISTENT_PRODUCT = "inconsistent-product"
    {static} CATEGORY_NOT_FOUND = "category-not-found"
    {static} GROUP_REJECTED = "group-rejected"
  }
  class ImportedSkuUpdate <<final>> <<serviço>> {
    ImportedSkuUpdate(products, offers, offerService, inventoryService)
    --
    ~apply(seller, row, skuId) : Uni<ImportResult>
  }
  class ImportedProductCreation <<final>> <<serviço>> {
    ImportedProductCreation(categories, productService, offerService, inventoryService)
    --
    ~create(seller, productRef, rows) : Uni<List<ImportResult>>
  }
  class ImportSteps <<final, pacote privado>> <<serviço>> {
    {static} sequentially(items, step) : Uni<List<R>>
    {static} price(row) : Price
    {static} isRefusal(e) : boolean
    {static} invalidRow(message) : DomainRuleViolation
    {static} failed(row, productId, e) : ImportResult
  }
  interface "ProductImportService.Unit" as Unit <<sealed, privada>>
  class "ProductImportService.NewProduct" as NewProduct <<record, privada>> {
    productRef : String
    rows : List<ImportRow>
  }
  class "ProductImportService.ExistingSku" as ExistingSku <<record, privada>> {
    row : ImportRow
    skuId : UUID
  }
  class "ProductImportService.Rejected" as Rejected <<record, privada>> {
    result : ImportResult
  }
  class "ImportedProductCreation.Prepared" as Prepared <<record, privada>> {
    row : ImportRow
    sku : NewSku
    price : Price
    onHand : int
  }
}

class "Actor" as Actor <<record>> #F5FAFF;line.dashed;line:1565C0
class "domain.Price" as Price #F6FBF6;line.dashed;line:2E7D32
class "ProductService.NewSku" as NewSku <<record>> #F5FAFF;line.dashed;line:1565C0

ImportResult --> ImportOutcome
ImportResult ..> ImportRow : succeeded / failed
ProductImport --> ImportStatus
ProductImport ..> Actor : seller()
Claimed --> ProductImport
Summary --> ProductImport
Report --> ProductImport
Report "1" *-- "0..*" ImportResult : lines
ProductImportService +-- Report
ProductImportService +-- Unit
ProductImportService +-- NewProduct
ProductImportService +-- ExistingSku
ProductImportService +-- Rejected
Unit <|.. NewProduct
Unit <|.. ExistingSku
Unit <|.. Rejected
NewProduct "1" *-- "1..*" ImportRow
ExistingSku --> ImportRow
Rejected --> ImportResult
ImportedProductCreation +-- Prepared
ProductImportService --> ImportedSkuUpdate : ExistingSku
ProductImportService --> ImportedProductCreation : NewProduct
ImportedSkuUpdate ..> ImportSteps
ImportedProductCreation ..> ImportSteps
ProductImportService ..> ImportSteps : sequentially
Prepared --> ImportRow
Prepared --> NewSku
Prepared ..> Price

note bottom of ProductImportService
  Do ProductImportService, só os tipos aninhados e as constantes de código aparecem aqui; as
  operações dele estão em classes-aplicacao-casos-de-uso. Unit agrupa as linhas do CSV: produto
  novo, SKU já existente ou grupo rejeitado. Summary traz as contagens por desfecho sem
  as linhas (GET com lines=false e a lista); Position é o cursor da lista, por createdAt
  e id. Report, Claimed, Summary e Position são públicos; Unit, NewProduct, ExistingSku,
  Rejected e Prepared são privados. ProductImportService planeja as unidades e grava os
  resultados; ImportedSkuUpdate aplica preço e estoque ao SKU existente e
  ImportedProductCreation cria o produto do grupo, as duas pelos casos de uso de produto,
  oferta e estoque. ImportSteps converte a recusa de negócio em linha FAILED.
end note

