{
  "name": "catalog-inventory-admin-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/catalog-inventory/admin/data-access/src",
  "prefix": "app",
  "projectType": "library",
  "tags": [
    "scope:catalog-inventory",
    "layer:data-access",
    "framework:angular",
    "lang:ts"
  ],
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/contracts/catalog-inventory/openapi.json",
        "{projectRoot}/openapi-ts.config.ts",
        "{projectRoot}/src/client-config.ts",
        {
          "externalDependencies": [
            "@hey-api/openapi-ts"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/src/generated"
      ],
      "options": {
        "command": "openapi-ts -f openapi-ts.config.ts -s",
        "cwd": "{projectRoot}"
      }
    }
  },
  "implicitDependencies": [
    "catalog-inventory-contracts"
  ]
}
