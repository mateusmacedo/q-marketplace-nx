{
  "name": "marketplace-workspace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "graph": "nx graph",
    "check": "node --test tools/check-boundaries.test.mjs && node tools/check-boundaries.mjs",
    "check:observability": "bash tools/observability-check.sh",
    "check:chart": "bash tools/chart-check.sh",
    "check:images": "node --test tools/check-images.test.mjs && node tools/check-images.mjs",
    "check:vulnerabilities": "bash tools/vulnerability-scan.sh",
    "infra:budget": "bash tools/infra-budget.sh",
    "test": "nx run-many -t test",
    "build": "nx run-many -t assemble",
    "dev:catalog": "nx run catalog-inventory-service:serve",
    "dev:admin": "nx run admin-web:serve",
    "smoke": "node tools/smoke.mjs",
    "load": "bash tools/load/run.sh average",
    "load:check": "bash tools/load/run.sh --check",
    "load:smoke": "bash tools/load/run.sh smoke",
    "load:average": "bash tools/load/run.sh average",
    "load:stress": "bash tools/load/run.sh stress",
    "load:spike": "bash tools/load/run.sh spike",
    "load:soak": "bash tools/load/run.sh soak",
    "load:breakpoint": "bash tools/load/run.sh breakpoint"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.6",
    "@angular-devkit/schematics": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@eslint/js": "9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@nx/angular": "24.0.4",
    "@nx/devkit": "24.0.4",
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/gradle": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/playwright": "24.0.4",
    "@nx/web": "24.0.4",
    "@playwright/test": "1.65.0",
    "@schematics/angular": "22.2.6",
    "@swc/helpers": "0.5.24",
    "@types/node": "24.19.2",
    "@typescript-eslint/utils": "8.72.1",
    "@vitest/browser-playwright": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "1.8.3",
    "jsdom": "27.4.0",
    "nx": "24.0.4",
    "playwright": "1.65.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@angular/aria": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@coreui/angular": "5.7.42",
    "@coreui/coreui": "5.9.1",
    "@coreui/icons": "3.1.0",
    "@coreui/icons-angular": "5.7.42",
