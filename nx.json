{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 1,
  "plugins": [
    {
      "plugin": "@nx/gradle",
      "options": {
        "buildTargetName": "gradle-build",
        "ciTestTargetName": "test-ci"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "include": ["apps/**/*", "libs/**/*"],
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/tsconfig.base.json",
      {
        "runtime": "node --version"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/docs/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/README.md",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)"
    ]
  },
  "targetDefaults": {
    "assemble": {
      "cache": true,
      "outputs": ["{projectRoot}/build/libs", "{projectRoot}/build/quarkus-app"]
    },
    "test": {
      "cache": true
    },
    "serve": {
      "cache": false
    },
    "native": {
      "cache": false
    },
    "container": {
      "cache": false
    },
    "quarkusDev": {
      "cache": false
    },
    "quarkusRemoteDev": {
      "cache": false
    },
    "quarkusRun": {
      "cache": false
    },
    "spotlessApply": {
      "cache": false
    },
    "spotlessJavaApply": {
      "cache": false
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "e2e": {
      "cache": false
    },
    "e2e-ci": {
      "cache": false
    },
    "e2e-ci--**/*": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{projectRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/contexts.json",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "groups": {
      "apps": {
        "projectsRelationship": "independent",
        "projects": ["tag:layer:service", "tag:layer:web-app"]
      },
      "libs": {
        "projectsRelationship": "independent",
        "projects": ["tag:layer:domain", "tag:layer:application"]
      },
      "contracts": {
        "projectsRelationship": "independent",
        "projects": ["tag:layer:contract"]
      }
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish"
    }
  },
  "analytics": true,
  "nxCloudId": "6aefee2a5c73bb897c69723c",
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  }
}
