{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 1,
  "plugins": [
    {
      "plugin": "@nx/gradle",
      "options": {
        "buildTargetName": "gradle-build",
        "ciTestTargetName": "test-ci"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/build.gradle",
      "{workspaceRoot}/settings.gradle",
      "{workspaceRoot}/gradle.properties",
      "{workspaceRoot}/gradle/**/*",
      "{workspaceRoot}/gradlew",
      "{workspaceRoot}/gradlew.bat",
      "{workspaceRoot}/tools/**/*",
      "{workspaceRoot}/package-lock.json",
      {
        "runtime": "java -version"
      },
      {
        "runtime": "node --version"
      }
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/build/**/*",
      "!{projectRoot}/docs/**/*",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "assemble": {
      "cache": true,
      "outputs": [
        "{projectRoot}/build/libs",
        "{projectRoot}/build/quarkus-app"
      ]
    },
    "test": {
      "cache": true
    },
    "serve": {
      "cache": false
    },
    "native": {
      "cache": false
    },
    "container": {
      "cache": false
    },
    "quarkusDev": {
      "cache": false
    },
    "quarkusRemoteDev": {
      "cache": false
    },
    "quarkusRun": {
      "cache": false
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "groups": {
      "apps": {
        "projectsRelationship": "independent",
        "projects": [
          "tag:layer:service"
        ]
      },
      "libs": {
        "projectsRelationship": "independent",
        "projects": [
          "tag:layer:domain",
          "tag:layer:application"
        ]
      },
      "contracts": {
        "projectsRelationship": "independent",
        "projects": [
          "tag:layer:contract"
        ]
      }
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish"
    }
  },
  "analytics": true,
  "nxCloudId": "6aefee2a5c73bb897c69723c",
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:library": {
      "linter": "eslint"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  }
}
