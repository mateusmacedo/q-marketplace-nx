          "11111111-1111-4111-8111-111111111111"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "moderator-demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "catalog-moderator"
      ]
    },
    {
      "username": "checkout-demo",
      "enabled": true,
