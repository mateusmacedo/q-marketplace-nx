          "22222222-2222-4222-8222-222222222222"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "seller-demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "seller"
      ]
    },
    {
