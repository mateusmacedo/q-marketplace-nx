# Executável nativo (GraalVM/Mandrel) gerado por `nx run <serviço>:native`, sobre a micro image recomendada pelo Quarkus.
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0@sha256:bae87e5f97128b773fd6a53af3d489536be836829a6a399bf079c13d2759cf99
ARG APP
WORKDIR /work
COPY --chown=10001:10001 --chmod=0755 apps/${APP}/build/*-runner ./application
USER 10001:10001
ENV QUARKUS_HTTP_PORT=8080
EXPOSE 8080
ENTRYPOINT ["./application"]
