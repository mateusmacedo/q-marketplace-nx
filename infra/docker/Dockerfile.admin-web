# Painel (ADR 027): arquivos estáticos gerados por `nx run admin-web:build`, servidos pelo nginx sem root, que também
# leva /api/<contexto> ao serviço pela rede interna, na mesma origem do painel.
FROM nginxinc/nginx-unprivileged:1.31.7-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e
COPY infra/docker/admin-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/apps/admin-web/browser /usr/share/nginx/html
EXPOSE 8080
