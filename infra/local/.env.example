# Copie para infra/local/.env (ignorado pelo git) e ajuste. Todo valor tem padrão no compose; este arquivo só
# documenta o que pode ser sobrescrito, e os padrões servem só ao ambiente local.

# Portas no host, sempre em 127.0.0.1.
CATALOG_PORT=8083
# Porta de gestão (saúde e /q/metrics) de cada papel do catálogo.
CATALOG_API_MANAGEMENT_PORT=9083
CATALOG_WORKER_MANAGEMENT_PORT=9084
KEYCLOAK_PORT=8180
KAFKA_PORT=9094
# PostgreSQL compartilhado (banco marketplace, um schema por contexto) e Redis do cache do catálogo, abertos a
# clientes como DBeaver, pgAdmin e RedisInsight (README, seção Clientes de banco).
POSTGRES_PORT=5432
REDIS_PORT=6379
# Redpanda Console, a interface do Kafka.
KAFKA_CONSOLE_PORT=8090
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Senhas locais. Roles do PostgreSQL: postgres (superusuário, só administração), catalog_inventory (runtime do
# catálogo, só DML), catalog_inventory_migrator (dono do schema, usado pelo Flyway) e exporter (o postgres-exporter).
POSTGRES_PASSWORD=postgres-local
CATALOG_INVENTORY_DB_PASSWORD=catalog-inventory-local
CATALOG_INVENTORY_DB_MIGRATOR_PASSWORD=catalog-inventory-migrator-local
POSTGRES_EXPORTER_PASSWORD=exporter-local-postgres
# Usuários da ACL do Redis: catalog (o serviço), exporter (o redis-exporter) e inspector (só leitura, para clientes).
REDIS_CATALOG_PASSWORD=catalog-local-redis
REDIS_EXPORTER_PASSWORD=exporter-local-redis
REDIS_INSPECTOR_PASSWORD=inspector-local-redis
# Usuário admin do Keycloak e do Grafana.
KEYCLOAK_ADMIN_PASSWORD=admin-local
GRAFANA_ADMIN_PASSWORD=admin

# Telemetria: o catálogo exporta traces e logs ao Collector (true desliga). O Collector guarda todo trace com erro ou
# acima de TAIL_SAMPLING_LATENCY_MS e a porcentagem TAIL_SAMPLING_PERCENTAGE dos demais.
CATALOG_OTEL_SDK_DISABLED=false
TAIL_SAMPLING_PERCENTAGE=100
TAIL_SAMPLING_LATENCY_MS=500

# Cache Redis da vitrine e da taxonomia (ADR 024), desligado por padrão: no A/B ele não trouxe ganho; true liga.
CATALOG_CACHE_ENABLED=false

# Partições de cada tópico criado pelo kafka-init.
KAFKA_TOPIC_PARTITIONS=3

# Validação do JWT no catálogo; sem estas linhas, vale o Keycloak local.
# CATALOG_JWT_ISSUER=http://localhost:8180/realms/marketplace
# CATALOG_JWT_JWKS_URL=http://keycloak:8080/realms/marketplace/protocol/openid-connect/certs
# CATALOG_JWT_AUDIENCE=catalog-inventory
# CATALOG_JWT_GROUPS_PATH=realm_access/roles

# Swagger UI em http://localhost:8083/q/swagger-ui.
CATALOG_SWAGGER_UI_ENABLED=true
