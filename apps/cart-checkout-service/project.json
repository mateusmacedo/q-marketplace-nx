{
  "name": "cart-checkout-service",
  "projectType": "application",
  "tags": ["scope:cart-checkout", "layer:service", "lang:java"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :cart-checkout-service:quarkusDev"
      }
    },
    "native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :cart-checkout-service:assemble -Dquarkus.native.enabled=true -Dquarkus.package.jar.enabled=false -Dquarkus.native.container-build=true"
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "dependsOn": ["native"],
      "options": {
        "command": "docker build -f infra/docker/Dockerfile.native --build-arg APP=cart-checkout-service -t marketplace/cart-checkout:local ."
      }
    }
  }
}
