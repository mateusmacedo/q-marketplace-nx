{
  "name": "catalog-inventory-service",
  "projectType": "application",
  "tags": ["scope:catalog-inventory", "layer:service", "lang:java"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :catalog-inventory-service:quarkusDev"
      }
    },
    "native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :catalog-inventory-service:assemble -Dquarkus.native.enabled=true -Dquarkus.package.jar.enabled=false -Dquarkus.native.container-build=true"
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "dependsOn": ["native"],
      "options": {
        "command": "docker build -f infra/docker/Dockerfile.native --build-arg APP=catalog-inventory-service -t marketplace-nx/catalog-inventory:local ."
      }
    }
  }
}
