@startuml classes-raiz
!include ../../../../docs/diagramas/tema-catalogo.iuml
!include <tupadr3/font-awesome-5/sliders_h>
title $I_QUARKUS Raiz do serviço e pacote config: configuração tipada, produtores CDI dos casos de uso, varredor de reservas e info

hide empty members
hide <<entrada>> stereotype
hide <<saida>> stereotype
hide <<serviço>> stereotype
hide <<infra>> stereotype
skinparam nodesep 20
skinparam ranksep 40

package "<$sliders_h,scale=0.55,color=#455A64> config (dev.marketplace.cataloginventory.config)" as pkg_config <<infra>> {
  interface "<$sliders_h,scale=0.55,color=#455A64> CatalogConfig" as CatalogConfig <<@ConfigMapping(prefix = "catalog")>> {
    security() : Security
    persistence() : Persistence
    reservations() : Reservations
    events() : Events
    imports() : Imports
    metrics() : Metrics
    cache() : Cache
  }
  interface "CatalogConfig.Security" as CfgSecurity {
    tenantClaim() : String = tenant_id
    storeClaim() : String = store_id
  }
  interface "CatalogConfig.Persistence" as CfgPersistence {
    timeout() : Duration = 2s
  }
  interface "CatalogConfig.Reservations" as CfgReservations {
    defaultTtl() : Duration = 15m
    maxTtl() : Duration = 2h
    maxLifetime() : Duration = 24h
    sweepBatch() : int = 200
    sweepInterval() : String
  }
  interface "CatalogConfig.Events" as CfgEvents {
    productTopic() : String
    offerTopic() : String
    inventoryTopic() : String
    storeTopic() : String
    relayBatch() : int = 100
    relayMaxBatches() : int = 20
    relayInterval() : String
    publishTimeout() : Duration = 10s
    maxBackoff() : Duration = 60s
    maxAttempts() : int = 20
    outboxRetention() : Duration = 7d
    inboxRetention() : Duration = 30d
    purgeInterval() : String
    purgeBatch() : int = 10000
    purgeMaxDuration() : Duration = 50s
    consumerRetries() : int = 10
  }
  interface "CatalogConfig.Imports" as CfgImports {
    interval() : String
    maxRows() : int = 5000
    lease() : Duration = 5m
  }
  interface "CatalogConfig.Metrics" as CfgMetrics {
    refreshInterval() : String
  }
  interface "CatalogConfig.Cache" as CfgCache {
    enabled() : boolean = true
    ttl() : Duration = 60s
    generationTtl() : Duration = 24h
    timeout() : Duration = 100ms
    invalidationTimeout() : Duration = 1s
  }
}

package "<$server,scale=0.55,color=#455A64> raiz (dev.marketplace.cataloginventory)" as raiz <<infra>> {
  class "<$cogs,scale=0.55,color=#1565C0> CatalogBeans" as CatalogBeans <<produtores CDI>> <<serviço>> {
    <<@Produces @ApplicationScoped>> clock() : Clock
    <<@Produces @ApplicationScoped>> categoryService(@CacheBacked categories) : CategoryService
    <<@Produces @ApplicationScoped>> productService(products, @CacheBacked categories, sellers, offers, clock)
    <<@Produces @ApplicationScoped>> offerService(products, offers, clock)
    <<@Produces @ApplicationScoped>> inventoryService(inventory, products, clock)
    <<@Produces @ApplicationScoped>> catalogStatsService(stats, clock)
    <<@Produces @ApplicationScoped>> storefrontService(products, sellers, offers)
    <<@Produces @ApplicationScoped>> productActions(sellers)
  }
  class "<$cogs,scale=0.55,color=#1565C0> ModerationBeans" as ModerationBeans <<produtores CDI>> <<serviço>> {
    <<@Produces @ApplicationScoped>> moderationService(products, @CacheBacked categories, sellers, offers, @CacheBacked reasons, clock)
    <<@Produces @ApplicationScoped>> moderationReasonService(@CacheBacked reasons, clock)
    <<@Produces @ApplicationScoped>> sellerEligibilityService(sellers)
  }
  class "<$cogs,scale=0.55,color=#1565C0> ImportBeans" as ImportBeans <<produtores CDI>> <<serviço>> {
    <<@Produces @ApplicationScoped>> importedSkuUpdate(products, offers, offerService, inventoryService)
    <<@Produces @ApplicationScoped>> importedProductCreation(@CacheBacked categories, productService, offerService, inventoryService)
    <<@Produces @ApplicationScoped>> productImportService(imports, products, skuUpdate, productCreation, clock)
  }
  class "<$cogs,scale=0.55,color=#1565C0> ReservationBeans" as ReservationBeans <<produtores CDI>> <<serviço>> {
    <<@Produces @ApplicationScoped>> reservationService(reservations, inventory, config, clock)
  }
  class "<$clock,scale=0.55,color=#EF6C00> ReservationSweeper" as ReservationSweeper <<@ApplicationScoped>> <<entrada>> {
    -reservations : ReservationService
    -config : CatalogConfig
    -lifecycle : Lifecycle
    -expired : Counter
    --
    <<@Scheduled reservation-sweeper, SKIP>> sweep() : Uni<Void>
  }
  class "<$plug,scale=0.55,color=#EF6C00> ServiceInfoResource" as ServiceInfoResource <<@Path("/internal/info"), @PermitAll>> <<entrada>> {
    GET / : info() : Map<String, String>
  }
}

class "application.ReservationService" as ReservationService <<serviço>> #line.dashed
class "application: demais casos de uso (10), ProductActions,\nImportedSkuUpdate e ImportedProductCreation" as UseCases <<serviço>> #line.dashed
class "cache.CachedPorts\n(@CacheBacked CategoryRepository e ModerationReasonRepository)" as CachedPorts <<saida>> #line.dashed
class "observability.Lifecycle" as Lifecycle <<infra>> #line.dashed

CatalogConfig +-- CfgSecurity
CatalogConfig +-- CfgPersistence
CatalogConfig +-- CfgReservations
CatalogConfig +-- CfgEvents
CatalogConfig +-- CfgImports
CatalogConfig +-- CfgMetrics
CatalogConfig +-- CfgCache
ReservationBeans ..> CatalogConfig : reservationService
CatalogBeans ..> CachedPorts : @CacheBacked categories
ModerationBeans ..> CachedPorts : @CacheBacked categories e reasons
ImportBeans ..> CachedPorts : @CacheBacked categories
ReservationBeans ..> ReservationService : produz
CatalogBeans ..> UseCases : produz
ModerationBeans ..> UseCases : produz
ImportBeans ..> UseCases : produz
ReservationSweeper --> ReservationService : expireDue(sweepBatch)
ReservationSweeper --> CatalogConfig
ReservationSweeper --> Lifecycle : job

CatalogBeans -[hidden]right- ModerationBeans
ModerationBeans -[hidden]right- ImportBeans
ImportBeans -[hidden]right- ReservationBeans
ReservationBeans -[hidden]right- ReservationSweeper
ReservationSweeper -[hidden]right- ServiceInfoResource
CatalogBeans -[hidden]down- CatalogConfig

note bottom of CatalogBeans
  Os quatro produtores montam os casos de uso da aplicação (Java puro) em @ApplicationScoped,
  atrás do proxy do ArC. Os que leem taxonomia ou o catálogo de motivos recebem as portas
  qualificadas com @CacheBacked, que cache.CachedPorts produz com TaxonomyCache.over() e
  ModerationReasonCache.over(). Todos os pacotes do serviço dependem do pacote config por
  CatalogConfig; nenhum pacote importa a raiz.
end note

note right of ReservationSweeper
  Expira as reservas vencidas em lotes de sweepBatch e devolve o estoque;
  concurrentExecution = SKIP impede sobreposição no mesmo pod.
end note

legend right
  <b>Leitura</b>
  <back:#90A4AE>    </back> Configuração tipada (prefixo catalog, com padrões)
  <back:$BORDA_APLICACAO>    </back> Montagem e casos de uso da aplicação
  <back:$BORDA_ENTRADA>    </back> Entrada: agendador e resource interno
  <back:$BORDA_SAIDA>    </back> Saída / <back:$BORDA_INFRA>    </back> Infraestrutura
  Borda tracejada: classe de outro pacote
endlegend
@enduml
