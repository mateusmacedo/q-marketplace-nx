@startuml classes-api-modelos-operacao
!include ../../../../docs/diagramas/tema-catalogo.iuml
!include <tupadr3/font-awesome-5/calendar_check>
title $I_API Pacote api: DTOs de operação (OfferModels, InventoryModels, ReservationModels e ProductImportModels)

hide empty members
hide <<requisicao>> stereotype
hide <<resposta>> stereotype
hide <<serviço>> stereotype
hide <<dominio>> stereotype
skinparam ClassBackgroundColor<<requisicao>> $COR_ENTRADA
skinparam ClassBorderColor<<requisicao>> $BORDA_ENTRADA
skinparam ClassBackgroundColor<<resposta>> #E0F7FA
skinparam ClassBorderColor<<resposta>> #00838F
skinparam nodesep 15
skinparam ranksep 30

package "<$tag,scale=0.6,color=#EF6C00> OfferModels <<final>>" as offerModels {
  class PriceDto <<record>> {
    listPrice : MoneyDto
    salePrice : MoneyDto
    --
    toDomain() : Price
    {static} of(price) : PriceDto
  }
  class PromotionRequest <<record>> <<requisicao>> {
    salePrice : MoneyDto
    startsAt : Instant
    endsAt : Instant
  }
  class PromotionResponse <<record>> <<resposta>> {
    id : UUID
    salePrice : MoneyDto
    startsAt : Instant
    endsAt : Instant
    phase : PromotionPhase
    --
    {static} of(promotion, now) : PromotionResponse
  }
  class EffectivePriceDto <<record>> <<resposta>> {
    listPrice : MoneyDto
    salePrice : MoneyDto
    promotionId : UUID
    priceVersion : long
  }
  class OfferResponse <<record>> <<resposta>> {
    skuId : UUID
    productId : UUID
    storeId : UUID
    currency : String
    price : PriceDto
    effectivePrice : EffectivePriceDto
    promotions : List<PromotionResponse>
    version : long
    --
    {static} of(offer, now) : OfferResponse
  }
}

class MoneyDto <<record>> {
  amount : BigDecimal
  currency : String
  --
  toDomain() : Money
  {static} of(money) : MoneyDto
}

package "<$warehouse,scale=0.6,color=#EF6C00> InventoryModels <<final>>" as inventoryModels {
  class StockResponse <<record>> <<resposta>> {
    skuId : UUID
    onHand : int
    reserved : int
    available : int
    sold : long
    version : long
  }
  class AdjustStockRequest <<record>> <<requisicao>> {
    onHand : Integer
  }
}

package "<$calendar_check,scale=0.6,color=#EF6C00> ReservationModels <<final>>" as reservationModels {
  class ItemRequest <<record>> <<requisicao>> {
    skuId : UUID
    quantity : Integer
    expectedUnitPrice : MoneyDto
    --
    toDomain() : RequestedItem
  }
  class CreateReservationRequest <<record>> <<requisicao>> {
    orderRef : String
    ttlSeconds : Long
    items : List<ItemRequest>
  }
  class ExtendReservationRequest <<record>> <<requisicao>> {
    ttlSeconds : Long
  }
  class ReservationItemResponse <<record>> <<resposta>> {
    skuId : UUID
    productId : UUID
    storeId : UUID
    quantity : int
    unitPrice : MoneyDto
    priceVersion : long
  }
  class ReservationResponse <<record>> <<resposta>> {
    id : UUID
    orderRef : String
    status : ReservationStatus
    createdAt : Instant
    expiresAt : Instant
    closedAt : Instant
    items : List<ReservationItemResponse>
  }
}

package "<$file_csv,scale=0.6,color=#EF6C00> ProductImportModels <<final>>" as importModels {
  class ImportCounts <<record>> <<resposta>> {
    created : int
    updated : int
    unchanged : int
    failed : int
    --
    {static} of(lines) : ImportCounts
  }
  class ImportLineResponse <<record>> <<resposta>> {
    lineNumber : int
    sellerSku : String
    outcome : ImportOutcome
    code : String
    message : String
    productId : UUID
    reasonDetails : List<Problem.ReasonDetail>
  }
  class ImportResponse <<record>> <<resposta>> {
    id : UUID
    status : ImportStatus
    totalLines : int
    processedLines : int
    counts : ImportCounts
    createdAt : Instant
    startedAt : Instant
    finishedAt : Instant
    lines : List<ImportLineResponse> (nulo com lines=false)
    --
    {static} of(job, lines) : ImportResponse
    {static} of(report) : ImportResponse
    {static} of(summary) : ImportResponse
  }
}

class "domain.Money" as Money <<dominio>> #line.dashed
class "domain.Price" as Price <<dominio>> #line.dashed
class "domain.RequestedItem" as RequestedItem <<dominio>> #line.dashed
class "application.ProductImportService.Report" as Report <<serviço>> #line.dashed
class "application.ProductImportRepository.Summary" as Summary <<serviço>> #line.dashed

PriceDto --> MoneyDto
PromotionRequest --> MoneyDto
PromotionResponse --> MoneyDto
EffectivePriceDto --> MoneyDto
OfferResponse --> PriceDto
OfferResponse --> EffectivePriceDto
OfferResponse "1" *-- "0..*" PromotionResponse
ItemRequest --> MoneyDto
CreateReservationRequest "1" *-- "1..*" ItemRequest
ReservationItemResponse --> MoneyDto
ReservationResponse "1" *-- "1..*" ReservationItemResponse
ImportResponse --> ImportCounts
ImportResponse "1" *-- "0..*" ImportLineResponse
MoneyDto ..> Money : toDomain
PriceDto ..> Price : toDomain
ItemRequest ..> RequestedItem : toDomain
ImportResponse ..> Report : of
ImportResponse ..> Summary : of

note bottom of importModels
  Mesma convenção dos DTOs de catálogo: classes finais com construtor privado, entrada
  validada por Bean Validation e saída montada por métodos de fábrica. MoneyDto é usado
  também por StorefrontModels (via EffectivePriceDto).
end note

legend right
  <b>Leitura</b>
  <back:$BORDA_ENTRADA>    </back> Requisição (entrada validada por Bean Validation)
  <back:#00838F>    </back> Resposta (montada por método de fábrica)
  <back:#90A4AE>    </back> DTO compartilhado entre entrada e saída
  <back:$BORDA_APLICACAO>    </back> Aplicação / <back:$BORDA_DOMINIO>    </back> Domínio
  Borda tracejada: classe de outro pacote
endlegend
@enduml
