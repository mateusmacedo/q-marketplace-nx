@startuml c4-conteiner
!include <C4/C4_Container>

title Catálogo-inventário — contêineres (C4 nível 2)

Person(seller, "Seller", "Papel seller")
Person(moderador, "Moderador", "Papel catalog-moderator")
Person(admin, "Admin do catálogo", "Papel catalog-admin")
Person(comprador, "Comprador", "Anônimo, só a vitrine")

System_Ext(checkout, "Checkout e OMS", "Contas de serviço com o papel catalog-reservations")
System_Ext(kyb, "KYB/KYC", "Produz SellerApproved, SellerRejected e ReviewRequired")
System_Ext(consumidores, "Consumidores de eventos", "Nenhum implementado no repositório")

System_Boundary(catalogo, "Catálogo-inventário") {
  Container(api, "catalog-inventory-api", "Quarkus nativo, perfil prod,api", "HTTP de negócio (8080 no contêiner); grava no banco e na outbox; sem agendadores e sem Kafka")
  Container(worker, "catalog-inventory-worker", "Quarkus nativo, perfil prod,worker", "Agendadores e consumidor KYB; só a porta de gestão 9000")
  ContainerDb(pg, "PostgreSQL", "Schema catalog_inventory", "Catálogo, ofertas, estoque, reservas, outbox, inbox e importações")
  ContainerDb(redis, "Redis", "Standalone, opcional", "Cache da vitrine e da taxonomia; desligado por padrão")
}

System_Ext(kafka, "Kafka", "Tópicos catalog-inventory.*.v1, kyb-kyc.seller.v1 e DLQ")
System_Ext(keycloak, "Keycloak", "Realm marketplace; JWT com tenant_id, store_id e papéis")
System_Ext(otel, "OTel Collector", "Recebe traces e logs por OTLP (4317)")

Rel(seller, api, "Produtos, SKUs, ofertas, estoque, importação", "HTTPS/JSON + JWT")
Rel(moderador, api, "Fila e decisões de moderação", "HTTPS/JSON + JWT")
Rel(admin, api, "Taxonomia e leitura do tenant", "HTTPS/JSON + JWT")
Rel(comprador, api, "GET /storefront/...", "HTTPS/JSON")
Rel(checkout, api, "Reserva, confirma, libera e estende", "HTTPS/JSON + Idempotency-Key")

Rel(api, pg, "Lê e grava; outbox na mesma transação", "Reactive SQL Client")
Rel(api, redis, "Lê e invalida, se habilitado", "RESP")
Rel(api, keycloak, "Busca chaves públicas", "JWKS")
Rel(worker, pg, "Outbox, inbox, reservas vencidas, importações", "Reactive SQL Client")
Rel(worker, redis, "Invalida após veredito e importação, se habilitado", "RESP")
Rel(worker, kafka, "Publica eventos (acks=all, idempotente)", "Kafka")
Rel(kafka, worker, "Entrega vereditos do KYB/KYC", "Kafka")
Rel(kyb, kafka, "Publica em kyb-kyc.seller.v1", "Kafka")
Rel(kafka, consumidores, "catalog-inventory.product|offer|inventory|store.v1", "Kafka")
Rel(api, otel, "Traces e logs", "OTLP")
Rel(worker, otel, "Traces e logs", "OTLP")

SHOW_LEGEND()
@enduml
