@startuml dados-er
hide circle
skinparam linetype ortho

title Catálogo-inventário — modelo de dados (schema catalog_inventory, V1 a V5)

package "V1 — catálogo" {
  entity category {
    * id : uuid <<PK>>
    --
    * tenant_id : uuid
    parent_id : uuid <<FK category>>
    * ancestry : uuid[]
    * code : varchar(60) <<UK tenant_id+code>>
    * name : varchar(120)
    * attributes : jsonb
    * active : boolean
    * version : bigint
  }
  entity product {
    * id : uuid <<PK>>
    --
    * tenant_id : uuid
    * store_id : uuid
    * category_id : uuid <<FK category>>
    * currency : char(3)
    * title : varchar(200)
    * description : varchar(5000)
    * attributes : jsonb
    * status : varchar(30) <<CHECK sem OUT_OF_STOCK>>
    * version : bigint
  }
  entity sku {
    * id : uuid <<PK>>
    --
    * product_id : uuid <<FK product>>
    * tenant_id, store_id : uuid
    * position : integer
    * seller_sku : varchar(64) <<UK tenant+store+seller_sku>>
    * variant_attributes : jsonb
    * physical : boolean
    height_cm, width_cm, length_cm : numeric(6,2)
    weight_g : integer
  }
  entity product_status_change {
    * id : uuid <<PK>>
    --
    * product_id : uuid <<FK product>>
    * transition, from_status, to_status : varchar(30)
    * actor : varchar(255)
    reason : varchar(500)
    * occurred_at : timestamptz
  }
  entity seller_eligibility {
    * tenant_id : uuid <<PK>>
    * store_id : uuid <<PK>>
    --
    * status : varchar(20)
    * decided_at : timestamptz
  }
}

package "V2 — oferta" {
  entity offer {
    * sku_id : uuid <<PK, FK sku CASCADE>>
    --
    * product_id : uuid <<FK product>>
    * tenant_id, store_id : uuid
    * currency : char(3)
    list_price : numeric
    * sale_price : numeric
    * price_version : bigint
    * version : bigint
  }
  entity offer_promotion {
    * id : uuid <<PK>>
    --
    * sku_id : uuid <<FK offer CASCADE>>
    * sale_price : numeric(19,2)
    * starts_at, ends_at : timestamptz
  }
}

package "V3 — estoque e reservas" {
  entity inventory_level {
    * sku_id : uuid <<PK, FK sku>>
    --
    * product_id : uuid <<FK product>>
    * tenant_id, store_id : uuid
    * on_hand : integer
    * reserved : integer
    * sold : bigint
    * version : bigint
  }
  entity inventory_adjustment {
    * id : uuid <<PK>>
    --
    * sku_id : uuid <<sem FK>>
    * previous_on_hand, new_on_hand : integer
    * actor : varchar(255)
    * occurred_at : timestamptz
  }
  entity inventory_reservation {
    * id : uuid <<PK>>
    --
    * tenant_id : uuid
    * idempotency_key : varchar(255) <<UK tenant_id+key>>
    * request_hash : char(64)
    order_ref : varchar(100)
    * status : varchar(20)
    * created_at, expires_at : timestamptz
    closed_at : timestamptz
  }
  entity inventory_reservation_item {
    * reservation_id : uuid <<PK, FK inventory_reservation>>
    * sku_id : uuid <<PK, sem FK>>
    --
    * product_id, store_id : uuid
    * quantity : integer
    * currency : char(3)
    * unit_price : numeric(19,2)
    * price_version : bigint
  }
}

package "V4 — mensageria" {
  entity outbox_event {
    * seq : bigint identity <<PK>>
    --
    * id : uuid <<UK>>
    * tenant_id : uuid
    * topic : varchar(200)
    * message_key : varchar(100)
    * event_type : varchar(60)
    * payload : json
    trace_parent : varchar(55)
    * created_at : timestamptz
    published_at : timestamptz
    * attempts : integer
    last_error : varchar(500)
  }
  entity inbox_message {
    * consumer : varchar(100) <<PK>>
    * event_id : uuid <<PK>>
    --
    * processed_at : timestamptz
  }
}

package "V5 — importação" {
  entity product_import {
    * id : uuid <<PK>>
    --
    * tenant_id, store_id : uuid
    * actor
    * status : PENDING | PROCESSING | COMPLETED
    * content : text
    * total_lines : integer
    * created_at : timestamptz
    started_at, finished_at : timestamptz
  }
  entity product_import_line {
    * import_id : uuid <<PK, FK product_import CASCADE>>
    * line_number : integer <<PK>>
    --
    seller_sku
    * outcome
    code, message
    product_id : uuid <<sem FK>>
  }
}

category |o--o{ category : "parent_id"
category ||--o{ product : "category_id"
product ||--|{ sku : "product_id"
product ||--o{ product_status_change : "product_id"
sku ||--o| offer : "sku_id"
product ||--o{ offer : "product_id"
offer ||--o{ offer_promotion : "sku_id"
sku ||--|| inventory_level : "sku_id"
product ||--o{ inventory_level : "product_id"
inventory_reservation ||--|{ inventory_reservation_item : "reservation_id"
product_import ||--o{ product_import_line : "import_id"
@enduml
