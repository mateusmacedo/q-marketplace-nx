newpage DELETE /products/{id}/skus/{skuId}: remover SKU (ProductService.removeSku)
autonumber 1
seller -> res : DELETE /products/{id}/skus/{skuId} + If-Match opcional
res -> res : @PermissionsAllowed(MANAGE_OWN_PRODUCTS); ETags.optional(If-Match)
opt #FFEBEE If-Match fraco (W/), sem aspas ou não numérico
  res -[#C62828]-> seller : <color:#C62828>400 invalid-request</color>
end
== Aplicação e regras de domínio ==
res -> svc : removeSku(actor, id, skuId, ifMatch)
svc -> svc : mutateOwned: ProductAccess.requireSeller
opt #FFEBEE sem MANAGE_OWN_PRODUCTS ou sem loja no token
  res -[#C62828]-> seller : <color:#C62828>403 access-denied</color>
end
svc -> repo : findById(tenant, id)
repo -> pg : SELECT product LEFT JOIN sku WHERE tenant_id AND id
opt #FFEBEE produto inexistente ou de outra loja
  res -[#C62828]-> seller : <color:#C62828>404 not-found</color>
end
svc -> svc : Versions.requireMatch(If-Match, versão lida) (ausente = sem checagem)
opt #FFEBEE If-Match diferente da versão lida
  res -[#C62828]-> seller : <color:#C62828>412 version-mismatch</color>
end
svc -> dom : removeSku(skuId, agora)
alt #FFEBEE produto fora de DRAFT
  res -[#C62828]-> seller : <color:#C62828>422 sku-removal-requires-draft</color>
else #FFEBEE SKU não pertence ao produto
  res -[#C62828]-> seller : <color:#C62828>422 sku-not-found</color>
else #E8F5E9 ok
  dom -> dom : tira o SKU da lista e atualiza updatedAt\n(sem transição, sem StatusChange e sem evento)
end
== Persistência transacional ==
svc -> dec : update(product, versão lida)
dec -> repo : update
repo -> pg : BEGIN; UPDATE product SET ... version = version + 1\nWHERE tenant_id AND id AND version = {versão lida}
alt #FFEBEE nenhuma linha atualizada (outra escrita venceu)
  repo -> pg : ROLLBACK
  res -[#C62828]-> seller : <color:#C62828>409 concurrent-update</color>
else #E8F5E9 ok
  repo -> pg : DELETE inventory_level dos SKUs removidos (só com on_hand = 0 e reserved = 0)
  repo -> pg : DELETE sku dos SKUs removidos (offer e offer_promotion saem em cascata)
  alt #FFEBEE SKU removido ainda com estoque ou reserva (FK inventory_level_sku_fk)
    repo -> pg : ROLLBACK
    res -[#C62828]-> seller : <color:#C62828>409 sku-has-stock</color>
  else #E8F5E9 ok
    repo -> pg : INSERT sku ... ON CONFLICT (id) DO UPDATE (SKUs que ficam, só se mudaram)
    repo -> pg : COMMIT (nenhum outbox_event: a remoção não publica evento)
    opt cache ligado
      dec -> redis : EVALSHA INVALIDATE (INCR catalog:gen:product:{tenant}:{produto})
    end
    res -> resp : ProductResponses.savedOk(product)
    resp -> pg : SELECT ... FROM inventory_level WHERE sku_id = ANY (SKUs que ficaram)
    res -[#2E7D32]-> seller : <color:#2E7D32><b>200</b></color> + ETag (versão + 1)
  end
end
$legenda_sequencia()

