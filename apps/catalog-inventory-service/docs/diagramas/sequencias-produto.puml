seller -> res : PUT /products/{id}/skus/{skuId} {variantAttributes, physical, dimensions} + If-Match
res -> res : @PermissionsAllowed(MANAGE_OWN_PRODUCTS); @Valid ReviseSkuRequest; ETags.required(If-Match);\nDimensionsDto.domainOf
opt #FFEBEE If-Match ausente, vazio ou *
  res -[#C62828]-> seller : <color:#C62828>428 precondition-required</color>
end
