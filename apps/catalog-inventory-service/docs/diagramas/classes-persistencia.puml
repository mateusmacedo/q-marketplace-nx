class PgSupport <<@ApplicationScoped>> <<saida>> {
  -timeout : Duration
  --
  bounded(operation) : Uni<T>
  customPlan(pool, sql, params) : Uni<RowSet<Row>>
  {static} unique(failure, constraint, code, message) : Throwable
  {static} batch(conn, sql, rows) : Uni<Void>
  {static} requireOneRow(result)
  {static} utc(instant) : OffsetDateTime
  {static} instant(value) : Instant
  {static} json(values) : JsonObject
  {static} strings(json) : Map<String, String>
}
class "<$envelope,scale=0.55,color=#6A1B9A> PgOutbox" as PgOutbox <<@ApplicationScoped, @Traced>> <<saida>> {
  -pool : Pool
  -clock : Clock
  --
  append(conn, messages) : Uni<Void>
  relay(batch, now, maxBackoff, maxAttempts, publish) : Uni<RelayRun>
  backlog() : Uni<Backlog>
  purge(publishedBefore, processedBefore, batch, maxDuration) : Uni<Integer>
}
