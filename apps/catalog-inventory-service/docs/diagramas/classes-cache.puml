class "<$broom,scale=0.55,color=#6A1B9A> ProductCacheInvalidation" as ProductCacheInvalidation <<@Decorator, @Priority(100)>> <<saida>> {
  -delegate : ProductRepository
  -cache : CatalogCache
  --
  <<@Inject>> ProductCacheInvalidation(@Delegate delegate, cache)
  insert(product) : invalida a vitrine do produto
  update(product, expectedVersion) : invalida a vitrine do produto
  <<demais operações delegam>>
}
class "<$broom,scale=0.55,color=#6A1B9A> OfferCacheInvalidation" as OfferCacheInvalidation <<@Decorator, @Priority(100)>> <<saida>> {
  -delegate : OfferRepository
  -cache : CatalogCache
  --
  <<@Inject>> OfferCacheInvalidation(@Delegate delegate, cache)
  insert(offer) : invalida a vitrine do produto
  update(offer, expectedVersion) : invalida a vitrine do produto
  <<leituras delegam>>
}
class "<$broom,scale=0.55,color=#6A1B9A> CategoryCacheInvalidation" as CategoryCacheInvalidation <<@Decorator, @Priority(100)>> <<saida>> {
  -delegate : CategoryRepository
  -cache : CatalogCache
  --
  <<@Inject>> CategoryCacheInvalidation(@Delegate delegate, cache)
  insert(category) : invalida a taxonomia do tenant
