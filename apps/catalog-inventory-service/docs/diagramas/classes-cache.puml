class CacheInvalidation <<utilitário>> {
  {static} PRIORITY = 100
  {static} after(cache, write, invalidate) : Uni<T>
  {static} when(cache, write, needed, invalidate) : Uni<T>
}

class "<$redis,scale=0.4,color=#D82C20> CatalogCache" as CatalogCache <<@ApplicationScoped, @Traced>> <<saida>> {
  {static} STOREFRONT = "storefront"
  {static} TAXONOMY = "taxonomy"
  {static} MODERATION_REASONS = "moderation-reasons"
  {static} REQUESTS, INVALIDATIONS, WRITES : métricas catalog.cache.*
  {static} READ, INVALIDATE : Script
  -enabled : boolean
  -redis : Redis
  -timeout, invalidationTimeout : Duration
  -ttl, generationTtl : String
  -registry : MeterRegistry
  -loaded : Map<Script, String>
  --
  enabled() : boolean
  read(cache, valueKey, generationKey, ownerKey, ...) : Uni<Lookup>
  write(cache, valueKey, stamp, content) : Uni<Void>
  remember(tenantId, productId, storeId) : Uni<Void>
  productChanged(tenantId, productId, storeId) : Uni<Void>
  storeChanged(tenantId, storeId) : Uni<Void>
  taxonomyChanged(tenantId) : Uni<Void>
  moderationReasonsChanged(tenantId) : Uni<Void>
  {static} detach(write)
}
class "CatalogCache.Lookup" as Lookup <<record>> {
  result : Result
  content : String
  --
  {static} UNMAPPED
  {static} BYPASS
}
enum "CatalogCache.Lookup.Result" as Result {
  HIT
  MISS
  UNMAPPED
  BYPASS
}
class "CatalogCache.Script" as Script <<record>> {
  source : String
}
class CacheKeys <<utilitário>> {
  {static} PREFIX = "catalog:"
  {static} productGeneration(tenantId, productId) : String
  {static} storeGenerationPrefix(tenantId) : String
  {static} storeGeneration(tenantId, storeId) : String
  {static} taxonomyGeneration(tenantId) : String
  {static} moderationReasonsGeneration(tenantId) : String
  {static} moderationReasons(tenantId) : String
  {static} productStore(tenantId, productId) : String
  {static} storefront(tenantId, productId) : String
  {static} chain(tenantId, categoryId) : String
  {static} children(tenantId, parentId, limit, afterCode) : String
}

