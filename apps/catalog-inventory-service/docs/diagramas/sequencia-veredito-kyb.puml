@startuml sequencia-veredito-kyb
!include ../../../../docs/diagramas/tema-catalogo.iuml
title $I_KYB Veredito do KYB/KYC: consumo com inbox
autonumber

box "Kafka" #F7F9FA
  queue "$I_KAFKA\nkyb-kyc.seller.v1" as topico
end box
box "Entrada" #FFFAF3
  participant "$I_WORKER\nSellerVerdictConsumer\n(worker)" as cons <<entrada>>
end box
box "Aplicação" #F5FAFF
  participant "$I_SERVICO\nSellerEligibilityService" as svc <<aplicacao>>
end box
box "Saída" #FBF6FC
  participant "$I_CACHE\nSellerCacheInvalidation" as dec <<saida>>
  participant "$I_REPOSITORIO\nPgSellerEligibilityRepository" as repo <<saida>>
end box
box "Infraestrutura" #F7F9FA
  database "$I_POSTGRES\nPostgreSQL" as pg
  database "$I_REDIS\nRedis" as redis
  queue "$I_KAFKA\ncatalog-inventory.kyb-seller.dlq" as dlq
end box

topico -> cons : mensagem (grupo catalog-inventory-service, earliest)
cons -> cons : parse do envelope
alt #FFEBEE JSON inválido, eventVersion != 1 ou campo ausente
  cons -> dlq : <color:#C62828>InvalidMessageException -> dead-letter-queue</color>
else #ECEFF1 eventType desconhecido
  cons -> topico : confirma sem efeito
else #E8F5E9 SellerApproved | SellerRejected | ReviewRequired
  cons -> cons : status APPROVED | REJECTED | PENDING;\nassocia correlationId
  cons -> svc : applyVerdict(veredito)\nretry com backoff 200 ms a 10 s, até 10 vezes
  svc -> dec : apply("catalog-inventory.seller-eligibility", veredito)
  dec -> repo : apply
  repo -> pg : BEGIN
  repo -> pg : INSERT inbox_message (consumer, event_id)\nON CONFLICT DO NOTHING
  alt #ECEFF1 nenhuma linha inserida
    repo -> pg : COMMIT
    repo --> dec : DUPLICATE
  else #F5FAFF nova
    repo -> pg : SELECT status ... FOR UPDATE
    repo -> pg : upsert seller_eligibility\nWHERE decided_at <= EXCLUDED.decided_at
    alt #ECEFF1 nenhuma linha atualizada
      repo -> pg : COMMIT
      repo --> dec : STALE
    else #E8F5E9 aplicada
      opt status mudou de fato
        repo -> pg : INSERT outbox_event StoreEligibilityChanged\n(catalog-inventory.store.v1, chave storeId)
      end
      repo -> pg : COMMIT
      repo --> dec : <color:#2E7D32>APPLIED</color>
    end
  end
  opt APPLIED ou falha, com cache ligado
    dec -> redis : incrementa catalog:gen:store:{tenant}:{loja}
  end
  dec --> cons : resultado
  cons -> cons : catalog.kyb.verdicts{outcome}++
  alt #FFEBEE retries esgotados
    cons -> dlq : <color:#C62828>falha -> dead-letter-queue</color>
  else #E8F5E9 ok
    cons -> topico : <color:#2E7D32>confirma (ack)</color>
  end
end
$legenda_camadas()
@enduml
