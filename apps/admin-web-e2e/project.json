{
  "name": "admin-web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin-web-e2e/src",
  "implicitDependencies": ["admin-web"],
  "// targets": "to see all targets run: nx show project admin-web-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "projects": ["infra-local"],
          "target": "up-catalog"
        },
        {
          "projects": ["admin-web"],
          "target": "serve-stack",
          "waitFor": "ready"
        }
      ]
    }
  },
  "tags": ["framework:none", "lang:ts"]
}
