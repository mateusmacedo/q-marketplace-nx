{
  "name": "order-management-service",
  "projectType": "application",
  "tags": ["scope:order-management", "layer:service", "lang:java"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :order-management-service:quarkusDev"
      }
    },
    "native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :order-management-service:assemble -Dquarkus.native.enabled=true -Dquarkus.package.jar.enabled=false -Dquarkus.native.container-build=true"
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "dependsOn": ["native"],
      "options": {
        "command": "docker build -f infra/docker/Dockerfile.native --build-arg APP=order-management-service -t marketplace/order-management:local ."
      }
    }
  }
}
