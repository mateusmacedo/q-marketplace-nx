{
  "name": "fulfillment-logistics-service",
  "projectType": "application",
  "tags": [
    "scope:fulfillment-logistics",
    "layer:service",
    "lang:java"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :fulfillment-logistics-service:quarkusDev"
      }
    },
    "native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/gradle.mjs :fulfillment-logistics-service:assemble -Dquarkus.native.enabled=true -Dquarkus.package.jar.enabled=false -Dquarkus.native.container-build=true"
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "native"
      ],
      "options": {
        "command": "docker build -f infra/docker/Dockerfile.native --build-arg APP=fulfillment-logistics-service -t marketplace/fulfillment-logistics:local ."
      }
    }
  }
}
